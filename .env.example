# Copy to .env.local for local development (`npm run dev`).
# In Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (Data API URL + publishable key).
# Both are public by design; your data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional extra gate in the web app: only these e-mails may use the dashboard.
ALLOWED_EMAILS=dev@example.com

# Secret for the daily keep-alive cron (any long random string).
CRON_SECRET=change-me
